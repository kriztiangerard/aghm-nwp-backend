    "insert:unifi-productlines": "tsx scripts/insert-unifi-productlines.ts",
    "pricing:smoke": "node --env-file=.env scripts/firecrawl-smoke.js",
    "pricing:review": "node --env-file=.env scripts/pricing-review.js",
    "pricing:set-manual": "node --env-file=.env scripts/pricing-set-manual.js",
    "seed:reyee-productlines": "tsx scripts/insert-reyee-productlines.ts",
    "seed:reyee-devices": "tsx scripts/seed-reyee-devices.ts",
    "insert:grandstream-productlines": "tsx scripts/insert-grandstream-productlines.ts",
    "seed:grandstream-devices": "tsx scripts/seed-grandstream-devices.ts",
    "seed:shoppable-sources": "tsx scripts/seed-shoppable-sources.ts"
  },
  "devDependencies": {
    "@swc/core": "^1.15.0",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.5",
    "@types/pg": "^8.23.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "aws-cdk": "2.1148.1",
    "esbuild": "^0.28.2",
    "jest": "^30",
    "tsx": "^4.23.0",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1000.0",
    "@tailwindcss/vite": "^4.3.3",
    "aws-cdk-lib": "2.275.0",
    "constructs": "^10.5.0",
    "dotenv": "^18.0.4",
    "json-schema-to-zod": "^2.8.1",
    "pg": "^8.23.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.5.4"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "@swc/core@1.16.1": true
  }
