{
  "type": "commonjs",
  "name": "aghm-nwp",
  "version": "0.1.0",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "generate:device-schemas": "tsx scripts/generate-device-schema.ts",
    "seed:devices": "node --import tsx scripts/seed-devices.ts",
